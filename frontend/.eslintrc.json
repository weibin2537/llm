{
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "prettier"
    ],
    "parser": "@babel/eslint-parser",
    "plugins": ["react", "react-hooks"],
    "env": {
      "browser": true,
      "node": true,
      "es6": true
    },
    "rules": {
      "react/prop-types": "off", // 如果使用 TypeScript, 可以关闭 prop-types 校验
      "react/jsx-uses-react": "off", // React 17 之后不再需要 jsx 语法引入 React
      "react/react-in-jsx-scope": "off"
    }
  }
  